# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email delivery (Resend) ---
# Without these, sign-in still works but no gift letters / reminders are sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Timegift <hello@your-verified-domain>"

# --- Push notifications (web-push / VAPID) ---
# Generate with: npx web-push generate-vapid-keys
# Without these, push prompts no-op silently.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@your-domain

# --- Cron auth ---
# If set, /api/decay, /api/random-exchange, /api/cron/* require
# `Authorization: Bearer ${CRON_SECRET}`. GitHub Actions sends this automatically.
CRON_SECRET=

# --- AI message generation (optional) ---
OPENAI_API_KEY=
GROQ_API_KEY=

# --- SMS / WhatsApp delivery (optional) ---
VONAGE_API_KEY=
VONAGE_API_SECRET=
WHATSAPP_API_KEY=

# --- Cloudflare Turnstile (optional, recommended for prod) ---
# Without these, anti-bot checks are passthrough.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Sentry error monitoring (optional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
