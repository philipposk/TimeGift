# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional (features degrade gracefully if missing) ---

# AI message generation. Either OpenAI or Groq works; OpenAI is tried first.
OPENAI_API_KEY=
GROQ_API_KEY=

# SMS / WhatsApp delivery via Vonage. Without these, in-app notifications still work.
VONAGE_API_KEY=
VONAGE_API_SECRET=
WHATSAPP_API_KEY=

# Cron protection. If set, /api/decay, /api/random-exchange, /api/cron/* require
# `Authorization: Bearer ${CRON_SECRET}`. Vercel cron sends this automatically.
CRON_SECRET=
